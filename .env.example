WEB_PORT=3010
POSTGRES_PORT=5434
DATABASE_URL="postgresql://opanywhere:opanywhere@localhost:5434/opanywhere?schema=public"
AUTH_SECRET="generate-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Scheduled night import (Asia/Bangkok)
IMPORT_SCHEDULE_HOUR=0
IMPORT_SCHEDULE_MINUTE=0
UPLOAD_ARCHIVE_DIR=./data/archive
WORKER_BATCH_SIZE=500
WORKER_MAX_JOBS_PER_RUN=1
